[Desktop Entry]
Version=1.0
Type=Application
Name=PDF Markdown Studio
Comment=Convert PDFs and images to markdown
Exec=pdf-markdown-studio %F
Icon=pdf-markdown-studio
StartupWMClass=pdf-markdown-studio
Terminal=false
Categories=Office;Viewer;
Keywords=PDF;Markdown;VLM;OCR;
MimeType=application/pdf;image/png;image/jpeg;image/bmp;image/gif;image/webp;image/tiff;
StartupNotify=true
